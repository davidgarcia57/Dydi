PORT=8080
GROUPS_SERVICE_URL=https://groups-service-mev3.onrender.com
HABITS_SERVICE_URL=https://dydi-jeru.onrender.com
REALTIME_SERVICE_URL=https://realtime-service-4mg6.onrender.com
SUPABASE_JWKS_URL=https://iuorcsmjgyljyzebfhbc.supabase.co/auth/v1/.well-known/jwks.json
# CORS de /api y allowlist de Origin del handshake /ws. Los clientes nativos no
# van aquí: su Origin espeja la URL que marcaron, o sea este gateway, y pasan por
# same-origin (ver internal/middleware/ws_origin.go).
ALLOWED_ORIGINS=https://dydi-xi.vercel.app,http://localhost:5173
INTERNAL_TOKEN=
WAKE_TOKEN=

# Rate limit por usuario (X-User-ID) en /api y /ws. Defaults de producción: 5/20.
# Para las corridas k6 (todos los VUs comparten la cuenta loadtest → una sola
# cubeta) subir temporalmente en Render, ej. RATE_LIMIT_RPS=2000, BURST=4000.
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20
