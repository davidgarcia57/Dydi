PORT=8084
MAX_CONNECTIONS_PER_GROUP=8
PING_INTERVAL_SECONDS=30
WRITE_WAIT_SECONDS=10
GROUPS_SERVICE_URL=https://groups-service-mev3.onrender.com
# ALLOWED_ORIGINS no va aqui: el allowlist de Origin del WebSocket lo aplica el
# gateway (api-gateway/internal/middleware/ws_origin.go). Detras del proxy el
# Host ya fue reescrito, asi que aqui el chequeo no puede ser correcto.
# Secreto interno servicio-a-servicio (mismo valor en groups/habits/realtime).
# Genera uno con: openssl rand -hex 32
INTERNAL_TOKEN=
